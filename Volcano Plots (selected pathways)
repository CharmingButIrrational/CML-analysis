#Select Significant
AS_G1_sig <- AS_G_vs_ACtrl %>% 
  dplyr::select(symbol, stat) %>% 
  na.omit() %>% 
  distinct() %>% 
  group_by(symbol) %>% 
  summarize(stat=mean(stat))

AS_G1_rank <- tibble::deframe(AS_G1_sig)

#Load the pathways into a named list
pathways.hallmark <- gmtPathways("c2.cp.kegg.v7.5.symbols.gmt")

fgseaRanksSig_AS <- fgsea(pathways=pathways.hallmark, stats=AS_G1_rank, nperm=1000)

topPathwaysUpAS <- fgseaRanksSig_AS[ES > 0][head(order(pval), n=10), pathway]
topPathwaysDownAS <- fgseaRanksSig_AS[ES < 0][head(order(pval), n=10), pathway]
topPathwaysAS <- c(topPathwaysUpAS, rev(topPathwaysDownAS))

topPathwaysASData <- fgseaRanksSig_AS[fgseaRanksSig_AS$pathway %in% topPathwaysAS]

topPathwaysASData <- topPathwaysASData[order(-NES)]

ggplot(topPathwaysASData, # you can replace the numbers to the row number of pathway of your interest
       aes(x = NES, y = reorder(pathway, NES))) + 
