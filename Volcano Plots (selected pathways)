#Differential expression analysis
dds <- DESeq(dds, fitType = "local")
plotDispEsts(dds)

#Get the Name
resultsNames(dds)

AS_G <- results(dds, name = "Treatment_TS_G_vs_AS_G", pAdjustMethod = "BH")

result_files <- list(AS_G)
names(result_files) <- c("AS_G")

for (i in names(result_files)) {
  result_files[[i]]$symbol <- mapIds(EnsDb.Hsapiens.v86,
                                     keys=row.names(result_files[[i]]),
                                     column="SYMBOL",
                                     keytype="GENEID",
                                     multiVals="first")
  result_files[[i]]$entrez <- mapIds(EnsDb.Hsapiens.v86,
                                     keys=row.names(result_files[[i]]),
                                     column="ENTREZID",
                                     keytype="GENEID",
                                     multiVals="first")
  result_files[[i]]$gene_name <- mapIds(org.Hs.eg.db,
                                        keys=as.character(result_files[[i]]$entrez),
                                        column="GENENAME",
                                        keytype="ENTREZID",
                                        multiVals="first")
}

